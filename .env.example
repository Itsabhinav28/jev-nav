# ─── Secrets (fill these in by hand; never commit .env) ───────────────────────
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# ─── Jev (TypeSafe) — the only decision-maker / source of truth ──────────────
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=15
JEV_MAX_CONCURRENCY=4
JEV_PRICE_PER_M_INPUT_TOKENS=0.042

# ─── Companion (Nemotron via OpenRouter) — talks, never decides ──────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COMPANION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
COMPANION_LANGUAGE=english   # english | hinglish

# ─── Speech (HeyGen via OpenRouter) ──────────────────────────────────────────
# The :free variant is listed as retiring on 2026-11-30 → then switch to
# TTS_MODEL=heygen/heygen-voice-1-turbo (paid, ~$7.50 per 1M characters).
TTS_MODEL=heygen/heygen-voice-1-turbo:free
TTS_VOICE=
TTS_FORMAT=pcm
TTS_SAMPLE_RATE=44100

# ─── Frames ──────────────────────────────────────────────────────────────────
SAMPLE_FPS=2
FULL_COUNCIL_EVERY_N=3
MAX_DECISION_LATENCY_S=2.5

# ─── Safety tuning ───────────────────────────────────────────────────────────
TRAFFIC_SIDE=left
PRESENCE_THRESHOLD=0.5
NAVIGATOR_MIN_CONFIDENCE=0.55
TTC_STOP_S=1.5
TTC_SLOW_S=3.5
RELEASE_STOP_FRAMES=2

# ─── Talking policy ──────────────────────────────────────────────────────────
CAUTION_COOLDOWN_S=4
INFO_COOLDOWN_S=12

OUTPUT_DIR=runs
