# VM-side config. Copy to /opt/jev-nav/.env, chmod 600. NEVER commit the real file.

# ─── Deployment ──────────────────────────────────────────────────────────────
# Your domain (no scheme). Instances are served at u1.DOMAIN, u2.DOMAIN, u3.DOMAIN
DOMAIN=example.com
# Comma-separated STUN servers (required in the cloud; the VM only sees its private IP)
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Email for Let's Encrypt expiry notices (used by DEPLOY.md commands)
LETSENCRYPT_EMAIL=you@example.com

# ─── Secrets (fill in by hand on the VM) ─────────────────────────────────────
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# ─── Jev (TypeSafe) ──────────────────────────────────────────────────────────
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=15
JEV_MAX_CONCURRENCY=4
JEV_PRICE_PER_M_INPUT_TOKENS=0.042

# ─── Companion (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COMPANION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
COMPANION_LANGUAGE=english

# ─── Speech ──────────────────────────────────────────────────────────────────
TTS_MODEL=heygen/heygen-voice-1-turbo:free
TTS_VOICE=nadine
TTS_FORMAT=pcm
TTS_SAMPLE_RATE=44100

# ─── Frames ──────────────────────────────────────────────────────────────────
SAMPLE_FPS=2
FULL_COUNCIL_EVERY_N=3
MAX_DECISION_LATENCY_S=2.5

# ─── Safety tuning ───────────────────────────────────────────────────────────
TRAFFIC_SIDE=left
PRESENCE_THRESHOLD=0.5
NAVIGATOR_MIN_CONFIDENCE=0.55
TTC_STOP_S=1.5
TTC_SLOW_S=3.5
RELEASE_STOP_FRAMES=2

# ─── Talking policy ──────────────────────────────────────────────────────────
CAUTION_COOLDOWN_S=4
INFO_COOLDOWN_S=12

OUTPUT_DIR=runs
